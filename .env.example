# Luno - Cloud Sync Configuration (Supabase)
# ==============================================================================
# Luno works 100% locally by default in Guest Mode without any external backend.
# To enable multi-device Cloud Sync and User Accounts, connect your Supabase project:
#
# 1. Create a free project at https://supabase.com
# 2. Run the SQL schema from supabase/schema.sql in the Supabase SQL Editor
# 3. Copy your project URL and anon public key below into your .env file
# ==============================================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
